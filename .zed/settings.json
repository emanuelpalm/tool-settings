{
  "agent": {
    "default_profile": "write",
    "model_parameters": [],
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            {
              "pattern": "^(awk|cargo|cat|cd|echo|find|grep|head|ls|p?npm|printf|sed|sort|tail|touch|uniq)\\b",
            },
            {
              "pattern": "^git\\s+(-[A-Za-z-]*(?:\\s+\\S+)?\\s+)*(status|log|show|diff|blame|shortlog|branch|describe|reflog|rev-parse|ls-files|ls-remote|ls-tree|cat-file|symbolic-ref|name-rev|grep|whatchanged|for-each-ref|help|version|count-objects|fsck)\\b",
            },
            { "pattern": "^node\\s+(-[A-Za-z-]*(?:\\s+\\S+)?\\s+)*--test\\b" },
            { "pattern": "^node\\s+--version$" },
            { "pattern": "^(npx\\s+)?tsc\\b" },
            { "pattern": "[<>]\\s*/dev/null|\\|\\s*tee\\s+[^|;]*/dev/null" },
          ],
          "always_deny": [
            {
              "pattern": "(^|[\\s\"'=<>])/(dev/null[\\w./-]|dev/nul($|[^l])|dev/nu($|[^l])|dev/n($|[^u])|dev/($|[^n])|dev($|[^/])|de($|[^v])|d($|[^e])|[^d/]|$)",
            },
            { "pattern": "(^|[\\s\"'=<>:])~" },
            { "pattern": "\\$\\{?HOME\\b" },
            { "pattern": "\\$\\{?(PWD|OLDPWD)\\b" },
            {
              "pattern": "\\.\\./|(^|[\\s\"'=])/\\.\\.($|[^.])|(^|[\\s\"'=])\\.\\.($|[^.])",
            },
            { "pattern": "(^|[/\\s\"'=<>:])\\.private(/|$|[\\s\"'])" },
            { "pattern": "(^|[/\\s\"'=<>:])\\.agents/skills(/|$|[\\s\"'])" },
            { "pattern": "\\bsudo\\b" },
            { "pattern": "^cd\\s*$" },
            { "pattern": "^find\\b.*\\s-(exec(dir)?|ok(dir)?|delete)\\b" },
            { "pattern": "^git\\s+config\\s+--(global|system|file)" },
            {
              "pattern": "^(cargo|p?npm).*\\b(commit|deploy|login|publish|submit)($|\\s|:)",
            },
          ],
        },
        "edit_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.agents/skills(/|$)" },
            { "pattern": "(^|/)\\.private(/|$)" },
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "(^|/)\\.\\.(/|$)" },
          ],
        },
        "write_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.agents/skills(/|$)" },
            { "pattern": "(^|/)\\.private(/|$)" },
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "(^|/)\\.\\.(/|$)" },
          ],
        },
        "delete_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.git(/|$)" },
            { "pattern": "(^|/)\\.agents/skills(/|$)" },
            { "pattern": "(^|/)\\.private(/|$)" },
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "(^|/)\\.\\.(/|$)" },
          ],
        },
        "move_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.git(/|$)" },
            { "pattern": "(^|/)\\.agents/skills(/|$)" },
            { "pattern": "(^|/)\\.private(/|$)" },
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "(^|/)\\.\\.(/|$)" },
          ],
        },
        "copy_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.agents/skills(/|$)" },
            { "pattern": "(^|/)\\.private(/|$)" },
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "(^|/)\\.\\.(/|$)" },
          ],
        },
        "create_directory": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.git(/|$)" },
            { "pattern": "(^|/)\\.agents/skills(/|$)" },
            { "pattern": "(^|/)\\.private(/|$)" },
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "(^|/)\\.\\.(/|$)" },
          ],
        },
        "fetch": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^https?://([a-z0-9-]+\\.)*docs\\.rs(/|$)" },
            { "pattern": "^https?://([a-z0-9-]+\\.)*github\\.com(/|$)" },
            { "pattern": "^https?://([a-z0-9-]+\\.)*npmjs\\.com(/|$)" },
          ],
        },
        "search_web": {
          "default": "allow",
        },
        "skill": {
          "default": "deny",
          "always_allow": [{ "pattern": "(^|/)\\.agents/skills/" }],
        },
      },
    },
  },
  "buffer_font_size": 14,
  "buffer_font_family": "Ubuntu Sans Mono",
  "cli_default_open_behavior": "existing_window",
  "icon_theme": "Zed (Default)",
  "languages": {
    "CSS": {
      "language_servers": [],
    },
    "Plain Text": {
      "language_servers": [],
    },
    "HTML": {
      "language_servers": [],
    },
    "JSON": {
      "language_servers": [],
    },
    "JSONC": {
      "language_servers": [],
    },
    "TypeScript": {
      "language_servers": [],
    },
    "TSX": {
      "language_servers": [],
    },
    "JavaScript": {
      "language_servers": [],
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "ui_font_size": 16,
}
